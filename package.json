{
  "name": "llm-proxy",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{js,json,jsonc,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
